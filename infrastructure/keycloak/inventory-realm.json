{
  "realm": "inventory",
  "displayName": "Inventory Management",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "inventory-audience",
      "description": "Identifies the inventory API as the token audience.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "inventory-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "inventory-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "inventory.access",
      "description": "Allows access to inventory management operations.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "inventory-api",
      "name": "Inventory API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    },
    {
      "clientId": "inventory-swagger",
      "name": "Inventory Swagger UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "https://localhost:7227/swagger/oauth2-redirect.html",
        "http://localhost:8080/swagger/oauth2-redirect.html"
      ],
      "webOrigins": [
        "https://localhost:7227",
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "inventory-audience"
      ],
      "optionalClientScopes": [
        "inventory.access"
      ]
    },
    {
      "clientId": "inventory-service",
      "name": "Inventory Service Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "inventory-audience"
      ],
      "optionalClientScopes": [
        "inventory.access"
      ]
    }
  ],
  "users": [
    {
      "username": "inventory-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Inventory",
      "lastName": "User",
      "email": "inventory-user@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
