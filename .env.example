# SQL Server
SQL_SERVER_HOST=sqlserver
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=InventoryManagement
SQL_SERVER_USER=inventory_app
SQL_SERVER_PASSWORD=
MSSQL_SA_PASSWORD=

# API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Keycloak
KEYCLOAK_PORT=8081
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_REALM=inventory
KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/inventory
KEYCLOAK_ISSUER=http://localhost:8081/realms/inventory
KEYCLOAK_AUDIENCE=inventory-api
KEYCLOAK_SWAGGER_CLIENT_ID=inventory-swagger
KEYCLOAK_SERVICE_CLIENT_ID=inventory-service
KEYCLOAK_SERVICE_CLIENT_SECRET=
